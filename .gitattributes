# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Windows scripts stay CRLF.
*.bat text eol=crlf

# The Gradle wrapper script must stay LF.
gradlew text eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jar binary
*.keystore binary
*.jks binary
